    <build>
        <!--
            Stable artifact filename, independent of <version> and Git branch.
            This lets docker-compose.yml bind-mount a fixed path
            (./target/creedengo-infra-plugin.jar) without needing edits at
            every release / branch switch.
        -->
        <finalName>creedengo-infra-plugin</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        The vendored test bases under src/test/java/org/sonar/iac/commons/testing/
                        (Abstract*Test, ExtensionSensorTest, *RulesDefinition*) were copied from a
                        newer sonar-iac source tree and reference APIs that are not on this module's
                        classpath (e.g. SensorContextTester#addTelemetryProperty added in
                        sonar-plugin-api 13.x). They are not referenced by any
                        org.greencodeinitiative.* test, so we exclude them from test compilation
                        until the imports/dependencies are re-synced.
                    -->
                    <testExcludes>
                        <exclude>org/sonar/iac/commons/testing/AbstractSensorTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/ExtensionSensorTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractMetricsTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractHighlightingTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractRulesDefinitionTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractCheckListTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractProfileDefinitionTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractExtensionTest.java</exclude>
                        <exclude>org/sonar/iac/commons/testing/AbstractExternalRulesDefinitionAssertions.java</exclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.sonar-packaging-maven-plugin</groupId>
                <artifactId>sonar-packaging-maven-plugin</artifactId>
                <version>${version.sonar-packaging}</version>
                <extensions>true</extensions>
                <configuration>
                    <pluginKey>creedengoinfra</pluginKey>
                    <pluginName>${project.name}</pluginName>
                    <pluginClass>org.greencodeinitiative.creedengo.infra.InfraPlugin</pluginClass>
                    <sonarLintSupported>false</sonarLintSupported>
                    <pluginApiMinVersion>${version.sonarqube}</pluginApiMinVersion>
                    <skipDependenciesPackaging>true</skipDependenciesPackaging>
                    <jreMinVersion>${java.version}</jreMinVersion>
                    <requiredForLanguages>js,ts,web,yaml</requiredForLanguages>
                    <archive>
                        <manifestEntries>
                            <Implementation-Build>${buildNumber}</Implementation-Build>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.maven-shade}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <minimizeJar>true</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>org.sonarsource.analyzer-commons:sonar-analyzer-commons:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.green-code-initiative:creedengo-rules-specifications:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>${version.buildnumber}</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <doCheck>false</doCheck>
                    <doUpdate>false</doUpdate>
                    <getRevisionOnlyOnce>true</getRevisionOnlyOnce>
                    <revisionOnScmFailure>0</revisionOnScmFailure>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${version.jacoco}</version>
                <configuration>
                    <output>file</output>
                    <append>false</append>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${version.license-maven-plugin}</version>
                <configuration>
                    <properties>
                        <owner>Green Code Initiative</owner>
                        <email>https://green-code-initiative.org</email>
                    </properties>
                    <licenseSets>
                        <licenseSet>
                            <header>com/mycila/maven/plugin/license/templates/GPL-3.txt</header>
                            <includes>
                                <include>${project.basedir}/src/**/*.java</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- activate integration tests -->
            <plugin>
                <!-- add integration test sources into test classpath -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-integration-test-sources</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/it/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-integration-test-resources</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>add-test-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/it/resources</directory>
                                </resource>
                                <resource>
                                    <filtering>true</filtering>
                                    <directory>${project.basedir}/src/it/resources-filtered</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Integration tests, mirroring the creedengo-java IT layout:
                  - Sources live under src/it/java (registered by the
                    build-helper plugin above).
                  - SonarQube + scanner are orchestrated by
                    org.green-code-initiative:creedengo-integration-test
                    (see GCIRulesBase / BuildProjectEngine).
                  - The test project under src/it/test-projects/ ships IaC
                    fixtures only (Dockerfile, K8s YAML, Terraform,
                    CloudFormation); packaging is `pom`, no Java to compile.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <test-it.sonarqube.keepRunning>${test-it.sonarqube.keepRunning}</test-it.sonarqube.keepRunning>
                                <test-it.orchestrator.artifactory.url>${test-it.orchestrator.artifactory.url}</test-it.orchestrator.artifactory.url>
                                <test-it.sonarqube.version>${version.test-it.sonarqube}</test-it.sonarqube.version>
                                <test-it.sonarqube.port>${test-it.sonarqube.port}</test-it.sonarqube.port>
                                <!--
                                    Plugins to install in the SonarQube instance:
                                      - the freshly built creedengo-infra plugin jar,
                                      - sonar-iac so Dockerfile / *.tf / Kubernetes /
                                        CloudFormation files are recognised by their
                                        respective Sonar languages.
                                -->
                                <test-it.plugins>
                                    ${project.baseUri}/target/${project.build.finalName}.jar,
                                    org.sonarsource.iac:sonar-iac-plugin:${test-it.sonar-iac.version},
                                </test-it.plugins>
                                <!--
                                    No backup profile is uploaded: the plugin itself
                                    contributes a built-in "creedengo way" profile
                                    per IaC language (InfraDockerQualityProfile,
                                    InfraKubernetesQualityProfile, …) that already
                                    activates the rule keys we assert against.
                                -->
                                <test-it.additional-profile-uris></test-it.additional-profile-uris>
                                <!-- Comma separated paths of "test projects" to analyze. Syntax: `sonar.projectKey|sonar.projectName|project.pomUri` -->
                                <test-it.test-projects>
                                    org.green-code-initiative:creedengo-infra-plugin-test-project|creedengo Infra Sonar Plugin Test Project|${project.baseUri}/src/it/test-projects/creedengo-infra-plugin-test-project/pom.xml,
                                </test-it.test-projects>
                                <!--
                                    Associate the built-in "creedengo way" profile to
                                    every IaC language so the rules contributed by the
                                    plugin are active during the scan.
                                -->
                                <test-it.test-project-profile-by-language>
                                    docker|creedengo way,
                                    kubernetes|creedengo way,
                                    terraform|creedengo way,
                                    cloudformation|creedengo way,
                                    yaml|creedengo way,
                                </test-it.test-project-profile-by-language>
                            </systemPropertyVariables>
                            <!--
                                Sonar Orchestrator spawns the scanner via the
                                `mvn` executable resolved from PATH (see
                                com.sonar.orchestrator.build.MavenBuildExecutor).
                                When the IT is launched from an IDE or via the
                                Maven wrapper, the inherited PATH may not include
                                a Maven installation, leading to:
                                    "Cannot run program \"mvn\": error=13, Permission denied".
                                We therefore prepend Maven's bin directory (and
                                JAVA_HOME's bin for safety) to PATH for the
                                forked Failsafe JVM, which in turn passes it on
                                to the Orchestrator subprocess.
                                The `maven.bin.path` property defaults to the
                                local install used by this workspace and can be
                                overridden on the command line, e.g.:
                                    ./mvnw verify -Dmaven.bin.path=/opt/homebrew/bin
                            -->
                            <environmentVariables>
                                <PATH>${maven.bin.path}:${env.PATH}</PATH>
                            </environmentVariables>
                            <!--
                                Keep sonar-iac-plugin OUT of the IT JVM's
                                classpath. The plugin's fat jar bundles an
                                older, *unshaded* `com.google.protobuf.*`
                                runtime (4.30.2) which shadows the
                                `protobuf-java:4.33` we declare for sonar-ws
                                (gencode 4.33). When `org.sonarqube.ws.Common$Severity`
                                initialises it calls
                                `RuntimeVersion.validateProtobufGencodeVersion`
                                and explodes with:
                                    ProtobufRuntimeVersionException: gencode 4.33.0, runtime 4.30.2.
                                The IT JVM only needs sonar-ws to talk to the
                                running SonarQube — it does NOT need the
                                sonar-iac plugin classes (those are loaded by
                                the SonarQube container, which Orchestrator
                                installs via `test-it.plugins`).
                            -->
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>org.sonarsource.iac:sonar-iac-plugin</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${version.sonar-maven-plugin}</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>keep-running</id>
            <properties>
                <test-it.sonarqube.keepRunning>true</test-it.sonarqube.keepRunning>
<!--                <test-it.sonarqube.port>9000</test-it.sonarqube.port>-->
                <test-it.sonarqube.port>33333</test-it.sonarqube.port>
            </properties>
        </profile>
    </profiles>
