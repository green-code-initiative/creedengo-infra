        <!-- Version of `sonar-iac-plugin` installed in the SonarQube instance used
             by integration tests so that Dockerfile / Kubernetes / Terraform /
             CloudFormation languages get detected during scan. -->
        <test-it.sonar-iac.version>1.46.0.15097</test-it.sonar-iac.version>

        <!--
            Directory containing the `mvn` executable, prepended to PATH for the
            Failsafe forked JVM. Sonar Orchestrator's MavenBuildExecutor invokes
            `mvn` from PATH; when launched from an IDE the inherited PATH may
            not include any Maven installation. Override on the command line if
            Maven lives elsewhere, e.g.:
                ./mvnw verify -Dmaven.bin.path=/opt/homebrew/bin
        -->
        <maven.bin.path>${user.home}/.maven/apache-maven-3.9.9/bin</maven.bin.path>

            <!-- URL of the Maven repository where sonarqube will be downloaded -->
        <test-it.orchestrator.artifactory.url>https://repo1.maven.org/maven2</test-it.orchestrator.artifactory.url>
        <!-- You can override this property to keep SonarQube instance running and to manually use it -->
        <test-it.sonarqube.keepRunning>false</test-it.sonarqube.keepRunning>
        <!-- SonarQube server listening port. Leave this property blank to automatically choose an available port. -->
        <test-it.sonarqube.port />

